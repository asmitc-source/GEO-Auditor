# Create a free GroqCloud key at https://console.groq.com/keys.
# Keep the account on Groq's free plan and never expose this key in browser code.
GROQ_API_KEY=

# The app pins Groq Compound Mini in server code and will not fall back to a
# paid provider or accept an environment override to another model.

# Local safeguards. The code hard-caps this at 200 calls/day even if a larger
# value is entered, leaving room below Groq's published free-plan request cap.
GROQ_DAILY_LIMIT=200
GROQ_CACHE_TTL_HOURS=168

# Reddit is intentionally excluded from source discovery in this version.
GROQ_EXCLUDE_DOMAINS=reddit.com

PORT=3000
