# Copy this file to .env and fill in your keys.

# Without this set, the AI citation probe check is skipped (not faked).
OPENAI_API_KEY=

# Reddit discovery — register a free "script" app at reddit.com/prefs/apps
# to get these. Without them set, the Reddit Discovery tab is skipped
# (not faked). No user login or posting permissions required — this is
# read-only search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=geo-auditor/1.0 (by /u/your-reddit-username)

PORT=3000
